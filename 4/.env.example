# .env.example
# Your Gemini API Key - must never be exposed containing VITE_ prefix. Used on server-side only.
GEMINI_API_KEY=

# Client-side Gemini API Key for direct chat integration (if used client-side)
VITE_GEMINI_API_KEY=

# API URL for AI Skills Assistant chat. Defaults to /api/ai-skill/chat
VITE_AI_SKILL_API_URL=
